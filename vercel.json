{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "gatsby",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/"
    },
    {
      "source": "/resume/",
      "destination": "/"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/contact/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/Game/Build/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/Game/Build/(.*)\\.unityweb",
      "headers": [
        {
          "key": "Content-Encoding",
          "value": "gzip"
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
